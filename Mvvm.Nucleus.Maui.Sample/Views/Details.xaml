<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Mvvm.Nucleus.Maui.Sample"
             x:Class="Mvvm.Nucleus.Maui.Sample.Details"
             x:DataType="local:DetailsViewModel"
             Title="Details">

    <ScrollView>
        
        <VerticalStackLayout
            Spacing="10"
            Margin="40">

            <Label 
                Text="Welcome to the details page."
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style="{StaticResource Headline}" />

            <!--
                These data labels use plain Text + StringFormat (not Label.FormattedText spans) so their
                values are exposed to the DevFlow visual tree registry and are queryable/assertable by the
                UI test suite (tests/ui/). FormattedText spans expose no text to the registry.
            -->
            <Label
                Text="{Binding PageIdentifier, StringFormat='View Identifier: {0}'}"/>

            <Label
                Text="{Binding PageIdentifier, StringFormat='Page Identifier: {0}'}"/>

            <Label
                Text="{Binding NavigationParameterData, StringFormat='Parameters: {0}'}"/>

            <Label
                Text="{Binding OnPrepareData, StringFormat='OnPrepare: {0}'}"/>

            <Label
                Text="{Binding OnRefreshData, StringFormat='OnRefresh: {0}'}"/>

            <ContentView />

            <Button
                Text="Show More Details (Regular)"
                Command="{Binding NavigatePushCommand}"/>

            <Button
                Text="Show More Details (Modal)"
                Command="{Binding NavigateModalCommand}"/>
            
            <Button
                Text="Show More Details (Modal + Stack)"
                Command="{Binding NavigateModalWithNavigationStackCommand}"/>

            <Button
                Text="Navigate Backwards"
                Command="{Binding NavigateBackCommand}"/>

            <Button
                Text="Navigate Backwards (confirm)"
                Command="{Binding NavigateBackWithConfirmCommand}"/>
            
            <Button
                Text="Navigate Backwards (twice)"
                Command="{Binding NavigateBackTwiceCommand}"/>

            <Button
                Text="Close Current Modal (if any)"
                Command="{Binding CloseModalCommand}"/>

            <Button
                Text="Close All Modals (if any)"
                Command="{Binding CloseAllModalCommand}"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>